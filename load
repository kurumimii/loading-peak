--=====================================================================
-- 4. HELPERS
--=====================================================================
local function make(className, props, parent)
    local instance = Instance.new(className)
    for key, value in pairs(props or {}) do
        instance[key] = value
    end
    if parent then
        instance.Parent = parent
    end
    return instance
end
local function addCorner(instance, radius)
    return make("UICorner", { CornerRadius = UDim.new(0, radius) }, instance)
end
local function addStroke(instance, color, thickness, transparency)
    return make("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, instance)
end
local function addGradient(instance, colors, rotation)
    local keypoints = {}
    for index, color in ipairs(colors) do
        local alpha = (#colors == 1) and 0 or (index - 1) / (#colors - 1)
        keypoints[index] = ColorSequenceKeypoint.new(alpha, color)
    end
    return make("UIGradient", {
        Color = ColorSequence.new(keypoints),
        Rotation = rotation or 0,
    }, instance)
end
local function copyList(source)
    local result = {}
    for index, value in ipairs(source) do
        result[index] = value
    end
    return result
end
local function shuffled(source)
    local copy = copyList(source)
    for index = #copy, 2, -1 do
        local randomIndex = math.random(1, index)
        copy[index], copy[randomIndex] = copy[randomIndex], copy[index]
    end
    return copy
end
local function thumbnailFor(player)
    local fallback = string.format(
        "rbxthumb://type=AvatarHeadShot&id=%d&w=420&h=420",
        player.UserId
    )
    local ok, result = pcall(function()
        return Players:GetUserThumbnailAsync(
            player.UserId,
            Enum.ThumbnailType.HeadShot,
            Enum.ThumbnailSize.Size420x420
        )
    end)
    if ok and type(result) == "string" then
        return result
    end
    return fallback
end
local function createThoughtStream(pool, onThought)
    local bag = {}
    local last = nil
    local stream = { delivered = 0 }
    local function refill()
        bag = shuffled(pool)
        if last and #bag > 1 and bag[1] == last then
            bag[1], bag[2] = bag[2], bag[1]
        end
    end
    function stream.next()
        if #bag == 0 then
            refill()
        end
        local thought = table.remove(bag, 1)
        last = thought
        stream.delivered = stream.delivered + 1
        if onThought then
            onThought(thought)
        end
        return thought
    end
    return stream
end
local function safeDestroy(instance)
    if instance and instance.Parent then
        instance:Destroy()
    end
end
