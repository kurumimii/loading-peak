local BootDuration = math.max(0.1, Config.durations.boot)
local GlideDuration = math.max(1, Config.durations.glide)
local StallDuration = math.max(1, Config.durations.stall)
local GlideStart = BootDuration
local StallStart = GlideStart + GlideDuration
local FinishLine = StallStart + StallDuration
local phrases = {
    BOOT = { index = "PHASE I  ·  SUMMONING", pill = "SUMMONING", color = Theme.emberSoft },
    GLIDE = { index = "PHASE II  ·  HYDRO GLIDE", pill = "HYDRO GLIDE", color = Theme.hydro },
    STALL = { index = "PHASE III  ·  HYPER-STALL", pill = "HYPER-STALL", color = Theme.violet },
    COMPLETE = { index = "PHASE IV  ·  COMPLETE", pill = "COMPLETE", color = Theme.ecto },
}
local ritual = {
    elapsed = 0,
    paused = false,
    done = false,
    thoughtClock = 0,
    nextThoughtIn = 0.35,
}
local connections = {}

local function percentAt(elapsed)
    if elapsed <= GlideStart then
        return (math.clamp(elapsed / BootDuration, 0, 1)) * 2
    elseif elapsed <= StallStart then
        local progress = (elapsed - GlideStart) / GlideDuration
        return 2 + math.clamp(progress, 0, 1) * 97
    elseif elapsed < FinishLine then
        local progress = (elapsed - StallStart) / StallDuration
        return 99 + math.clamp(progress, 0, 1) * 0.99
    end
    return 100
end

local function phaseAt(elapsed)
    if elapsed < GlideStart then
        return "BOOT"
    elseif elapsed < StallStart then
        return "GLIDE"
    elseif elapsed < FinishLine then
        return "STALL"
    end
    return "COMPLETE"
end

