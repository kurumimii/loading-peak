    if Main then
        local float = math.sin(tick() * 1.5) * 5
        Main.Position = UDim2.new(0.5, -190, 0.5, -150 + float)
    end
    if BarFill and PercentText then
        local progress = BarFill.Size.X.Scale * 100
        PercentText.Text = string.format("%.2f%%", progress)
    end
end)
