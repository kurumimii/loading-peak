-- Shuffle Function for No-Loop Feel
local function shuffleThoughts()
    local n = #thoughtPool
    for i = n, 2, -1 do
        local j = math.random(i)
        thoughtPool[i], thoughtPool[j] = thoughtPool[j], thoughtPool[i]
    end
end

-- MAIN LOGIC
task.spawn(function()
    -- Phase 1: Smooth 1-minute glide to 99%
    Status.Text = "🛡️ Starting system handshake..."
    TweenService:Create(BarFill, TweenInfo.new(60, Enum.EasingStyle.Linear), {Size = UDim2.new(0.99, 0, 1, 0)}):Play()
    task.wait(60)

    -- Phase 2: The 9-Minute Hyper-Stall (99% to 100%)
    TweenService:Create(BarFill, TweenInfo.new(540, Enum.EasingStyle.Linear), {Size = UDim2.new(1, 0, 1, 0)}):Play()
    
    local stallTime = 540
    local elapsed = 0
    
    while elapsed < stallTime do
        shuffleThoughts() -- Randomize order every few cycles
        for _, thought in ipairs(thoughtPool) do
            if elapsed >= stallTime then break end
            
            Status.Text = "⏳ " .. thought
            
            -- Fast random delay (0.4 to 1.2 seconds) makes it look hyper-active
            local waitTime = math.random(4, 12) / 10
            elapsed = elapsed + waitTime
            task.wait(waitTime)
        end
    end

    Status.Text = "✅ Success. Welcome, " .. lp.Name .. "!"
    task.wait(2)

    TweenService:Create(Main, TweenInfo.new(0.6, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0)}):Play()
    task.wait(0.7)
    ScreenGui:Destroy()
end)

-- Float & Precision % Update
