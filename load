table.insert(connections, RunService.Heartbeat:Connect(function(dt)
    if ritual.paused then
        lastTick = tick()
        return
    end

    local now = tick()
    local realDt = (now - lastTick) * Config.demo.timeScale
    lastTick = now

    if not ritual.done then
        ritual.elapsed = math.min(FinishLine, ritual.elapsed + realDt)
    end

    local currentPercent = percentAt(ritual.elapsed)
    local currentPhase = phaseAt(ritual.elapsed)

    local phraseData = phrases[currentPhase] or phrases.COMPLETE
    phaseIndexLabel.Text = phraseData.index
    phasePillLabel.Text = phraseData.pill
    phasePill.BackgroundColor3 = phraseData.color
    
    local alpha = math.clamp(currentPercent / 100, 0, 1)
    barFill.Size = UDim2.new(alpha, 0, 1, 0)
    percentLabel.Text = string.format("%.2f%%", currentPercent)

    ritual.thoughtClock = ritual.thoughtClock + realDt
    if ritual.thoughtClock >= ritual.nextThoughtIn and currentPhase ~= "COMPLETE" then
        ritual.thoughtClock = 0
        ritual.nextThoughtIn = math.random(Config.thoughts.minDelay * 10, Config.thoughts.maxDelay * 10) / 10
        local activeStream = streams[currentPhase]
        if activeStream then
            activeStream.next()
        end
    end

    if currentPhase == "COMPLETE" and not ritual.done then
        ritual.done = true
        streams.COMPLETE.next()
    end
end))

